{
  "name": "canvas-assignment-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"tsx watch src/server/index.ts\" \"vite\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "helper:install": "tsx src/helper/install.ts",
    "helper:uninstall": "tsx src/helper/install.ts uninstall",
    "extension:build": "esbuild src/extension/popup.ts src/extension/bridge.ts src/extension/autoGrab.ts --bundle --outdir=extension/build --target=chrome120"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
